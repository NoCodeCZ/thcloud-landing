LEAD_CRM_DATA_DIR=.data
NEXT_PUBLIC_WEBINAR_INITIAL_COUNT=0
FB_PIXEL_ID=your-facebook-pixel-id
NEXT_PUBLIC_FB_PIXEL_ID=your-facebook-pixel-id
FB_CAPI_ACCESS_TOKEN=your-facebook-capi-token
# Required — CRM admin auth fails closed if any are missing.
# ADMIN_PASSWORD must be 8+ chars. ADMIN_SESSION_SECRET must be 32+ chars of random bytes.
# Generate a secret: `openssl rand -hex 32`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
ADMIN_SESSION_SECRET=change-this-session-secret-at-least-32-chars
LARK_LEAD_WEBHOOK_URL=https://open.larksuite.com/open-apis/bot/v2/hook/your-webhook-id
